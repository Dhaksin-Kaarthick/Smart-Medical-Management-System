rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isCaregiver() {
      return isAuthenticated() && getUserData().role == 'caregiver';
    }
    
    function isPatient() {
      return isAuthenticated() && getUserData().role == 'patient';
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false; // Disallow user deletion via client
    }

    // PATIENTS COLLECTION
    match /patients/{patientId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (isCaregiver() || resource.data.userId == request.auth.uid);
      allow delete: if isCaregiver();
    }

    // MEDICINES COLLECTION
    match /medicines/{medicineId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isCaregiver();
    }

    // MEDICINE LOGS (Events written by ESP32 or Patient/Caregiver)
    match /medicine_logs/{logId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isCaregiver();
    }

    // DEVICES COLLECTION (IoT ESP32 Heartbeats & Status)
    match /devices/{deviceId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated(); // Allow ESP32 / Server SDK update
      allow delete: if isCaregiver();
    }

    // AI PREDICTIONS (Generated by FastAPI ML microservice)
    match /ai_predictions/{predictionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Write by microservice / caregiver trigger
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isCaregiver());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isCaregiver());
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
